{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    // CR-08 partial: checkJs stays false until the 1152 pre-existing JS errors
    // across src/screens, src/navigation, App.js and __tests__ are triaged.
    // Enabling checkJs:true surfaces them all and reds the gate (verified
    // 2026-10-01). Tracked for phased enablement before Phase 22.
    // The three highest-risk utilities (billingStorage, notifications,
    // vaultImport) are instead covered by runtime validation + ESLint.
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "widgets/**/*",
    "__tests__/**/*",
    "patch-llama-gradle.js",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "eslint.config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
