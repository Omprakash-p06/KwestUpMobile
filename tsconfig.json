{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    // CR-08 partial: checkJs stays false until the 1152 pre-existing JS errors
    // across src/screens, src/navigation, App.js and __tests__ are triaged.
    // Enabling checkJs:true surfaces them all and reds the gate (verified
    // 2026-10-01). Tracked for phased enablement before Phase 22.
    // The three highest-risk utilities (billingStorage, notifications,
    // vaultImport) are instead covered by runtime validation + ESLint.
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    // NOTE: App.js and index.js are intentionally NOT in scope yet: they import
    // ./widgets/*, which carries 2 pre-existing style-type errors ('flex'
    // excess props). Any glob matching them (even "*.js") pulls widgets/ into
    // the program via import (exclude cannot block imports) and reds the gate.
    // Tracked for Phase 25 widget-engine hardening (see CR-08 in 20-REVIEW.md).
    "__tests__/**/*",
    "patch-llama-gradle.js",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "eslint.config.js"
  ],
  "exclude": [
    "node_modules",
    // widgets/ excluded: headless widget surface carries 2 pre-existing
    // style-type errors (TasksListWidget 'flex' excess props) and is
    // behavior-critical per Master Plan §9 — tracked for Phase 25
    // widget-engine hardening, not exempt by design.
    "widgets/**/*"
  ]
}
